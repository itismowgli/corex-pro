# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# AI tooling
.claude/
.planning/

# macOS writes these AppleDouble sidecars whenever files reach the server
# through a tar or an SMB share. They are not project files, and counting them
# as local changes made `corex update` refuse to run on a clean repo.
._*
.DS_Store

# Python bytecode from agent/ syntax checks
__pycache__/
*.pyc

# Never commit anything that holds a credential. Nothing in this repo should
# contain one (the agent, bot and service secrets all live under /etc/corex or
# beside the service on the data mount), so these patterns exist to catch a
# file copied here by accident rather than to ignore a file we expect.
*.token
*.key
*.pem
agent.conf
telegram.conf
watchdog.conf
corex-credentials.txt
.env
.env.*
